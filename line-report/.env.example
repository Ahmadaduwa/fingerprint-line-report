# ---------- LINE Messaging API ----------
# Channel access token (long-lived) จาก LINE Developers Console > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=

# ปลายทางเริ่มต้น: userId (U...), groupId (C...) หรือ roomId (R...) คั่นด้วย ,
# (แนะนำให้จัดการผ่านหน้าเว็บพอร์ต 8090 แทน)
LINE_TO=
LINE_TARGET_ID=

# ---------- Database (SQL Server 2012 / HIP TIME 4.0) ----------
# บน Windows 7 แนะนำ DB_AUTH=windows (ไม่ต้องใช้รหัสผ่าน sa)
# หรือ DB_AUTH=sql ถ้าใช้ sa + password
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=hiptime
DB_AUTH=windows

# ---------- การสรุปรายงาน ----------
# เวลาตัดสาย (หลังเวลานี้ถือว่าสาย: 07:30)
LATE_TIME=07:30

# เวลาที่โปรแกรม HIP Time ดึง log เข้า DB อัตโนมัติ (09:00)
AUTO_DOWNLOAD_TIME=09:00

# เวลาส่งสรุปรายงานเข้า LINE (09:30)
SEND_TIMES=09:30

# สแกนช้ากว่าเวลาเข้างานไม่เกินกี่นาทีถึงยังไม่นับสาย
LATE_GRACE_MINUTES=0


# กะที่ใช้ถ้าพนักงานไม่ได้กำหนดกะ (ว่าง = ใช้เวลาเข้างานใน School = 08:00)
DEFAULT_SHIFT=01

# 1 = แสดงรายชื่อคนที่มาตรงเวลาด้วย
SHOW_PRESENT=1

# 1 = ส่งวันหยุดด้วย (ปกติจะส่งเฉพาะวันหยุดที่มีคนมาทำงาน)
SEND_ON_DAYOFF=0

# สรุปเฉพาะแผนก (Student.levelcode คั่นด้วย ,) ว่าง = ทุกคน
LEVELS=

# ชื่อที่แสดงหัวข้อความ (ว่าง = ใช้ School.schoolname)
COMPANY_NAME=STW_TeacherCheck

# ---------- Web UI Management ----------
WEB_PORT=8090
WEB_USERNAME=admin
WEB_PASSWORD=change_this_password
